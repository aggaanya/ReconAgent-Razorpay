VITE_API_BASE_URL=http://127.0.0.1:8001
# Keep at least the backend LLM per-attempt timeout plus transport margin.
# Local Ollama development defaults to 120000 + 30000 ms.
VITE_AI_RECONCILIATION_TIMEOUT_MS=150000
# Chat graph runs 2 sequential LLM calls (plan + interpret).
VITE_AI_CHAT_TIMEOUT_MS=270000
