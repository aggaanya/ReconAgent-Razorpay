# =============================================================================
# ReconAgent - ROOT environment reference template
#
# Each service reads its own .env file:
#   - backend/.env   (copy from backend/.env.example)
#   - frontend/.env  (copy from frontend/.env.example)
#
# This root file is a union reference for onboarding review.
# NEVER put real secrets here or commit any .env file.
# =============================================================================

# --- Backend: application ---
APP_NAME=ReconAgent API
VERSION=0.1.0
ENVIRONMENT=development

# --- Backend: CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Backend: database (PostgreSQL - required from Phase 2 onward) ---
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/reconagent

# --- Backend: auth (JWT - required when ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_HEX_VALUE

# --- Backend: AI provider (LLM_API_KEY required in production) ---
# Provider aliases (pick one or use LLM_* directly):
#   Option A: DeepSeek — DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_BASE_URL
#   Option B: Gemini  — GEMINI_API_KEY / GEMINI_MODEL / GEMINI_BASE_URL
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
