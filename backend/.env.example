# =============================================================================
# ReconAgent backend environment template
# Copy to backend/.env  ->  cp backend/.env.example backend/.env
# Never commit backend/.env.
#
# All integration credentials are optional until their phase lands:
# the service boots and passes /health without any of them.
# =============================================================================

# --- Application ---
APP_NAME=ReconAgent API
VERSION=0.1.0

# development | test | production
ENVIRONMENT=development

# --- CORS ---
# Comma-separated list of allowed browser origins (no trailing slashes).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL - required from Phase 2 onward) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/reconagent

# --- Auth (JWT - required when ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_HEX_VALUE

# --- AI provider (AI investigation phases - leave empty until then) ---
LLM_API_KEY=

# --- Razorpay (optional until integration phase) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
