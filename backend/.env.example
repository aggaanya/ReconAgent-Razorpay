# =============================================================================
# ReconAgent backend environment template
# Copy to backend/.env  ->  cp backend/.env.example backend/.env
# Never commit backend/.env.
#
# All integration credentials are optional until their phase lands:
# the service boots and passes /health without any of them.
# =============================================================================

# --- Application ---
APP_NAME=ReconAgent API
VERSION=0.1.0

# development | test | production
ENVIRONMENT=development

# --- CORS ---
# Comma-separated list of allowed browser origins (no trailing slashes).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL - required from Phase 2 onward) ---
# Driver-qualified form is recommended; plain postgresql:// also works.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/reconagent

# --- Auth (JWT - required when ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_HEX_VALUE

# --- AI provider (AI phases; LLM_API_KEY required in production) ---
# Never commit a real key. Leave empty to run without the AI layer.
LLM_API_KEY=
# Chat model served through the OpenAI-compatible API.
LLM_MODEL=gpt-4o-mini
# Optional: repoint at any OpenAI-compatible endpoint. Must be HTTPS.
LLM_BASE_URL=
# Per-request timeout in seconds (positive number).
LLM_TIMEOUT_SECONDS=30
# Client-side retries for transient failures 429/5xx/network errors (0-10).
LLM_MAX_RETRIES=2

# --- Razorpay (optional until integration phase) ---
# Use TEST MODE keys during development (Dashboard -> Settings -> API Keys).
# Never commit real keys; leave empty to run without Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Read-only REST API root. Must be HTTPS. Override only for testing.
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Per-request connect/read timeout in seconds (positive number).
RAZORPAY_TIMEOUT_SECONDS=10
# Bounded retries for transient failures (HTTP 429/5xx and network errors,
# read requests only). Permanent failures (401/403/404/400) never retry.
RAZORPAY_MAX_RETRIES=3
# Retry backoff: delays start at BASE, double each attempt, cap at MAX.
# Jitter randomizes each computed delay within [0, delay] to avoid
# synchronized thundering-herd retries across processes.
RAZORPAY_RETRY_BASE_DELAY_SECONDS=0.5
RAZORPAY_RETRY_MAX_DELAY_SECONDS=30
RAZORPAY_RETRY_JITTER=true

# --- Razorpay synchronization workflow ---
# Records fetched per API page (1-100; provider maximum is 100).
RAZORPAY_SYNC_PAGE_SIZE=100
# Hard cap on pages fetched per resource per run (each page = PAGE_SIZE records).
RAZORPAY_SYNC_MAX_PAGES=200
# Pause between pages in seconds (0-60) to stay friendly to rate limits.
RAZORPAY_SYNC_PAGE_DELAY_SECONDS=0.25
