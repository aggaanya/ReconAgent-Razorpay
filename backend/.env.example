# =============================================================================
# ReconAgent backend environment template
# Copy to backend/.env  ->  cp backend/.env.example backend/.env
# Never commit backend/.env.
#
# All integration credentials are optional until their phase lands:
# the service boots and passes /health without any of them.
# =============================================================================

# --- Application ---
APP_NAME=ReconAgent API
VERSION=0.1.0

# development | test | production
ENVIRONMENT=development

# --- CORS ---
# Comma-separated list of allowed browser origins (no trailing slashes).
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL - required from Phase 2 onward) ---
# Driver-qualified form is recommended; plain postgresql:// also works.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/reconagent

# --- Auth (JWT - required when ENVIRONMENT=production) ---
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_HEX_VALUE

# --- AI provider (AI phases; LLM_API_KEY required in production) ---
# Never commit a real key. Leave empty to run without the AI layer.

# --- Option A: DeepSeek API (recommended) ---
# OpenAI-compatible endpoint; maps to LLM_* fields automatically.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Option B: Google Gemini API ---
# Google's Generative AI OpenAI-compatible endpoint; maps to LLM_* fields
# automatically.  DeepSeek takes priority over Gemini when both are set.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-pro-preview


# --- Shared LLM settings (work with all providers) ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# NOTE: There are no external payment-provider credentials. ReconAgent
# operates on a normalized internal financial data model; synthetic data
# is provided for deterministic demos and evaluation.
